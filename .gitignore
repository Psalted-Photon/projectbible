node_modules/
.DS_Store
dist/
.cache/
.vscode/
*.log

# Python virtual environment
.venv/

# Data packs - allow committed packs for mobile deployment
# (packs are small enough for GitHub, ~16MB each)
# Ignore generated data sources, but allow final packs
data-sources/*
# …except the journeys editorial layer: the curated index, the licence and the
# notes are ours to keep, small, and the thing that makes the feature
# reproducible. The 179 UBS route files beside them stay ignored like every
# other source download — `node scripts/atlas/fetch-ubs-routes.mjs` re-fetches.
#
# Each level has to be unexcluded in turn: git does not descend into an
# excluded directory, so a bare `data-sources/` would hide these no matter what
# followed it.
!data-sources/maps/
data-sources/maps/*
!data-sources/maps/journeys/
data-sources/maps/journeys/*
!data-sources/maps/journeys/journey-index.json
!data-sources/maps/journeys/LICENSE.md
!data-sources/maps/journeys/README.md

# Large build artifacts (dictionary pipeline)
data/raw/
data/processed/
data/*.sqlite
scripts/dictionary-parsers/*.ndjson
scripts/dictionary-parsers/*.ndjson*
scripts/dictionary-parsers/gcide-historic.ndjson
wiktionary-modern.ndjson
wiktionary-modern-clean.ndjson
# SQLite WAL sidecar files (transient, should never be committed)
*.sqlite-shm
*.sqlite-wal

# BSB Audio pack - too large for GitHub (3.4GB MP3s)
# Users can rebuild with: npm run build:bsb-audio
packs/bsb-audio/audio/

# Electron
apps/electron/out/
apps/electron/release/

# Vite/TS
apps/pwa/.vite/
apps/pwa/dev-dist/


# Commentary packs (too large for git)
apps/pwa-polished/public/packs/commentaries.sqlite
apps/pwa-polished/public/packs/consolidated/commentaries.sqlite
packs/consolidated/commentaries.sqlite
packs/workbench/commentaries.sqlite

# Encyclotopical pack — 77 MB, and the Vercel build never reads it from LFS
# (ensure-bundled-packs fetches only five packs). It ships via the GitHub
# release, which is where production downloads it from.
packs/consolidated/encyclotopical.sqlite
apps/pwa-polished/public/packs/consolidated/encyclotopical.sqlite

# The Historical Map, on the same reasoning as Encyclotopical above: it ships
# via the GitHub release, which is where production downloads it from, so
# committing 34 MB through LFS on every rebuild buys nothing.
packs/consolidated/atlas-map.sqlite
packs/consolidated/atlas-map-*.sqlite
packs/consolidated/atlas-places.sqlite
apps/pwa-polished/public/packs/consolidated/atlas-map.sqlite
apps/pwa-polished/public/packs/consolidated/atlas-map-*.sqlite
apps/pwa-polished/public/packs/consolidated/atlas-places.sqlite

# What the map is built FROM. Intermediates, not products: 162 MB that never
# reaches a device, rebuilt by the scripts in scripts/atlas/ from Natural Earth,
# OpenStreetMap, the Barrington Atlas and GeoNames.
packs/atlas.sqlite
packs/basemap.sqlite
packs/gazetteer.sqlite

# The atlas lab's data — 81 MB of GeoJSON written by scripts/atlas/export-lab-layers.mjs
# for the dev-server lab page. Regenerated from the packs above, and the whole
# lab goes away once the map is in the app.
apps/pwa-polished/public/atlas/

# TTS runtime WASM (copied from node_modules by vite copyTtsRuntime plugin)
apps/pwa-polished/public/tts/

# Starter pack staged into public/ by scripts/ensure-starter-pack.mjs on every
# build. Committing it would put an LFS pointer in CI, which the origin would
# then serve as a 130-byte file that looks like a valid download.
apps/pwa-polished/public/starter.sqlite

# Local env files. Public build settings live in apps/pwa-polished/.env, which is
# committed; anything secret goes in a .local file so it never reaches git.
.env*.local

# Generated email previews (source of truth is supabase/email-templates)
.email-preview/
