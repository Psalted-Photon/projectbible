VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Wake alarm push notifications.
# Public half of the VAPID keypair — safe to ship in the client bundle.
# The private half lives only as a Supabase Edge Function secret (VAPID_PRIVATE_KEY);
# never put it in this file or any VITE_ variable.
VITE_VAPID_PUBLIC_KEY=
